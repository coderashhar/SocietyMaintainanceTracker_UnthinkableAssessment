# ─── DATABASE (NEON) ──────────────────────────────────────────────────────────
# Pooler URL (used by Prisma Client at runtime)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-calm-river-b3do9jk7-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct URL (used by Prisma Migrate)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-calm-river-b3do9jk7.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Strong random secret for signing JWTs
JWT_SECRET="your_super_secret_jwt_key_here"
# Token expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN="7d"

# ─── CLOUDINARY ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── RESEND (EMAIL) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# The "from" address
EMAIL_FROM="noreply@yourdomain.com"

# ─── OVERDUE THRESHOLD ───────────────────────────────────────────────────────
OVERDUE_THRESHOLD_DAYS=7
