# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local dev or Render managed Postgres)
DATABASE_URL="postgresql://myproject_user:your_password@localhost:5432/society_tracker?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Strong random secret for signing JWTs (use: openssl rand -base64 64)
JWT_SECRET="your_super_secret_jwt_key_here"
# Token expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN="7d"

# ─── CLOUDINARY ──────────────────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier is sufficient
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── RESEND (EMAIL) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 100 emails/day, 3000/month
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# The "from" address — must be a verified domain in Resend
# For quick testing you can use: onboarding@resend.dev (Resend sandbox)
EMAIL_FROM="noreply@yourdomain.com"

# ─── OVERDUE THRESHOLD ───────────────────────────────────────────────────────
# Number of days before an unresolved complaint is considered overdue.
# GRADING CRITERION: Change this value to adjust the overdue threshold.
# Default: 7 days. Set to any positive integer.
OVERDUE_THRESHOLD_DAYS=7

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── FRONTEND (Vite) ─────────────────────────────────────────────────────────
# Used in frontend/.env — prefix with VITE_ to expose to client bundle
# VITE_API_BASE_URL=http://localhost:4000/api
